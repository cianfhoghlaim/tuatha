{
  "name": "@tuatha/realm-canvas",
  "version": "0.2.0",
  "description": "PixiJS v8 2.5D Hades-orthographic realm canvas for the Tuatha British Isles Formative Assessment MMO. Per-subject palettes + sprite banks + layered parallax + particle emitters + audio cues. NO Babylon.js, NO SpacetimeDB, NO 3D worlds.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./viewport": "./src/viewport.ts",
    "./particles": "./src/particles.ts",
    "./audio": "./src/audio.ts",
    "./subjects/*": "./src/subjects/*.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pixi/sound": "^6.0.1",
    "pixi-particles": "^4.3.1",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "license": "BUSL-1.1"
}